{
  "subflow": {
    "name": "ROB Persist Authorization Lifecycle Native",
    "internalName": "x_2166123_rob_auth.rob_persist_authorization_lifecycle_native",
    "sysId": "dbfbb5fc8347c3504f5193a6feaad335",
    "reviewedMasterSnapshot": "459df5f08387c3504f5193a6feaad3b1",
    "table": "x_2166123_rob_auth_rob_auth",
    "outputs": []
  },
  "existingInputs": [
    "authorization_sys_id",
    "status_value",
    "cycle_identifier",
    "lapse_notice_value",
    "reminder_1_value",
    "reminder_2_value",
    "reminder_3_value"
  ],
  "newInputs": [
    {
      "name": "signature_stage",
      "type": "String",
      "allowedValues": ["employee", "supervisor"]
    },
    {
      "name": "signature_signer",
      "type": "Reference",
      "referenceTable": "sys_user"
    },
    {
      "name": "signature_date_time",
      "type": "DateTime"
    },
    {
      "name": "signature_document_task",
      "type": "Reference",
      "referenceTable": "sn_doc_task"
    },
    {
      "name": "signature_document_task_execution",
      "type": "Reference",
      "referenceTable": "sn_doc_task_execution"
    },
    {
      "name": "finalization_stage",
      "type": "String",
      "allowedValues": ["claim", "reset", "complete"]
    },
    {
      "name": "final_pdf_attachment",
      "type": "Reference",
      "referenceTable": "sys_attachment"
    },
    {
      "name": "final_pdf_generated_date_time",
      "type": "DateTime"
    },
    {
      "name": "final_authorization_date",
      "type": "Date"
    },
    {
      "name": "finalization_detail_status_value",
      "type": "String",
      "allowedValues": ["pending_fulfillment"]
    },
    {
      "name": "finalization_superseded_status_value",
      "type": "String",
      "allowedValues": ["superseded"]
    }
  ],
  "branches": {
    "employee": {
      "condition": "signature_stage is employee and finalization_stage is empty",
      "fieldMappings": {
        "employee_signature_complete": { "kind": "literal", "value": true },
        "employee_signer": { "kind": "pill", "input": "signature_signer" },
        "employee_signature_date_time": { "kind": "pill", "input": "signature_date_time" },
        "employee_document_task": { "kind": "pill", "input": "signature_document_task" },
        "document_task_execution": { "kind": "pill", "input": "signature_document_task_execution" },
        "status": { "kind": "literal", "value": "pending_supervisor_approval_signature" }
      }
    },
    "supervisor": {
      "condition": "signature_stage is supervisor and finalization_stage is empty",
      "fieldMappings": {
        "supervisor_signature_complete": { "kind": "literal", "value": true },
        "supervisor_signer": { "kind": "pill", "input": "signature_signer" },
        "supervisor_signature_date_time": { "kind": "pill", "input": "signature_date_time" },
        "supervisor_document_task": { "kind": "pill", "input": "signature_document_task" },
        "document_task_execution": { "kind": "pill", "input": "signature_document_task_execution" }
      }
    },
    "finalizationClaim": {
      "condition": "finalization_stage is claim, status is pending_supervisor_approval_signature, Supervisor evidence is complete, and final_pdf_attachment is empty",
      "fieldMappings": {
        "signed_pdf_generated": { "kind": "literal", "value": true }
      }
    },
    "finalizationReset": {
      "condition": "finalization_stage is reset and final_pdf_attachment is empty and status is not active",
      "fieldMappings": {
        "signed_pdf_generated": { "kind": "literal", "value": false }
      }
    },
    "finalizationComplete": {
      "condition": "finalization_stage is complete, all Employee/approval/Supervisor evidence is committed, claim is true, and the exact final PDF input is present",
      "fieldMappings": {
        "final_pdf_attachment": { "kind": "pill", "input": "final_pdf_attachment" },
        "signed_pdf_generated": { "kind": "literal", "value": true },
        "signed_pdf_generated_date_time": { "kind": "pill", "input": "final_pdf_generated_date_time" },
        "final_authorization_date": { "kind": "pill", "input": "final_authorization_date" },
        "effective_date": { "kind": "pill", "input": "final_authorization_date" },
        "status": { "kind": "pill", "input": "status_value", "expectedCallerValue": "active" }
      },
      "currentDetailMappings": {
        "status": { "kind": "pill", "input": "finalization_detail_status_value", "expectedCallerValue": "pending_fulfillment" },
        "authorized_start_date": { "kind": "pill", "input": "final_authorization_date" }
      },
      "predecessorMappings": {
        "superseded_by_authorization_form": { "kind": "pill", "value": "current authorization" },
        "status": { "kind": "pill", "input": "finalization_superseded_status_value", "expectedCallerValue": "superseded" }
      },
      "predecessorDetailMappings": {
        "status": { "kind": "pill", "input": "finalization_superseded_status_value", "expectedCallerValue": "superseded" }
      }
    },
    "existingLifecycle": {
      "condition": "signature_stage is empty and finalization_stage is empty",
      "behavior": "Preserve the current status/reminder/lapse Update Record mappings without change"
    }
  },
  "constraints": {
    "execution": "synchronous foreground",
    "dynamicTableInput": false,
    "genericFieldMapInput": false,
    "scriptedStatusBinding": false,
    "fixedAuthorizationAndDetailTables": true,
    "genericFinalizationFieldMapInput": false,
    "staticChoiceSelectorDependency": false,
    "fdDataChoiceBinding": false,
    "approvalFieldsOwnedByNativeApprovalFlow": true
  }
}
