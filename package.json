      "test:r3": "node --test scripts/validation/r3-authorization-decision.test.cjs",
      "verify:wave2:pdi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validation/verify-wave-2-deployment.ps1 -Auth rob-pdi"
